{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "EarthquakeIngestionSchedule": "0 */5 * * * *",
    "USGS__PageSize": "20000",
    "USGS__InitialLookbackHours": "24",
    "USGS__OverlapMinutes": "15",
    "PublicApi__Key": "set-a-long-random-secret-not-used-by-the-browser",
    "PublicApi__RequestsPerMinute": "60",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
    "ConnectionStrings__Oracle": "User Id=<user>;Password=<password>;Data Source=<service-name>;"
  }
}
