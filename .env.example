# Copy this file to .env and replace the placeholders.
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite
AZURITE_CONTAINER_NAME=earthquake-monitor-azurite
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFeqCnf2w==
AZURITE_BIND_ADDRESS=0.0.0.0
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

FUNCTIONS_CONTAINER_NAME=earthquake-monitor-functions
FUNCTIONS_HOST_PORT=7071
FUNCTIONS_CONTAINER_PORT=80
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated
TNS_ADMIN_PATH=/opt/oracle/wallet

EARTHQUAKE_INGESTION_SCHEDULE=0 */5 * * * *
USGS_PAGE_SIZE=20000
USGS_INITIAL_LOOKBACK_HOURS=1
USGS_OVERLAP_MINUTES=15

AZURE_WEBJOBS_STORAGE=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFeqCnf2w==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
ORACLE_CONNECTION_STRING=User Id=YOUR_ORACLE_USER;Password=YOUR_ORACLE_PASSWORD;Data Source=YOUR_TNS_ALIAS;Tns_Admin=/opt/oracle/wallet
